# Copy to .env for Docker Compose; never commit credentials.
JWT_SECRET=replace-with-a-random-secret-at-least-48-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ENVIRONMENT=development
# Production signup is opt-in; newly registered production users are analysts.
ALLOW_PUBLIC_REGISTRATION=false
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080
# Optional OpenAI-compatible provider. Leave blank for functional local tool mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
